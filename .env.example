# Copiar a `.env` y completar. El `.env` real NUNCA se commitea: lo carga
# config.py al arrancar y el entorno de verdad siempre le gana, para que
# Render y Docker sigan mandando ellos.

# ── Proxy ────────────────────────────────────────────────────────────────────
# Sin esto los buscadores bloquean la IP: medido el 2026-09-15 desde una
# conexion domestica, duckduckgo no conecta (timeout a nivel TCP) y brave
# devuelve 429. Solo bing atiende, y con un solo proveedor el resolutor de
# decisor baja a ~33% de aciertos.
#
# Formato: protocolo://usuario:clave@host:puerto
# Usar un proxy RESIDENCIAL o movil. Uno de datacenter suele venir ya quemado
# para estos buscadores y no cambia nada.
PROXY_URL=

# Verificar que sirve ANTES de confiar en el, con codigo de salida real:
#   python bench/verificar_proxy.py     -> 0 si mejora, 1 si no
#
# Compara cada proveedor con y sin proxy pasando por el mismo codigo que usa
# produccion. Si dice "no cambia nada", no lo pagues.

# ── Autenticacion del server ─────────────────────────────────────────────────
# Si se define, todos los endpoints salvo /health exigen el header X-API-Key.
API_KEY=

# ── Presupuestos, opcionales ─────────────────────────────────────────────────
# Solo tocar con una medicion que lo justifique. Los defaults estan en
# config.py con el motivo de cada numero al lado.
#
# DECISOR_BUDGET_S=25
# DECISOR_FETCH_TIMEOUT=6
# MAX_TIMEOUTS_PROVEEDOR=2
